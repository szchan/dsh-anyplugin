        "sha": "0123456789abcdef0123456789abcdef01234567"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "npm-helper",
      "source": {
        "source": "npm",
