{
  "name": "codex-marketplace",
  "interface": {
    "displayName": "Codex Marketplace Fixture"
  },
  "plugins": [
    {
      "name": "hello",
      "source": {
        "source": "local",
        "path": "./plugins/hello"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    },
    {
      "name": "hello-string",
      "source": "./plugins/hello",
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    },
    {
      "name": "remote-helper",
      "source": {
        "source": "url",
        "url": "https://example.invalid/remote-helper.git"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "git-helper",
      "source": {
        "source": "git-subdir",
        "url": "https://example.invalid/mono.git",
