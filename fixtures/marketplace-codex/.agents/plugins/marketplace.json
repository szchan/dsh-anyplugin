        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "unavailable",
      "source": {
        "source": "local",
        "path": "./plugins/hello"
      },
      "policy": {
        "installation": "NOT_AVAILABLE",
