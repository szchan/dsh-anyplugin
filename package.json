{
  "name": "dsh-anyplugin",
  "version": "0.2.0",
  "description": "Run Claude Code plugins inside DeepSeek Harness, at declared 100% fidelity.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szchan/dsh-anyplugin.git"
  },
  "engines": {
    "node": ">=22.14",
    "dsh": "0.2.2-rc.2 || 0.2.2-rc.5"
  },
  "main": "./lib/index.js",
  "bin": {
    "dsh-anyplugin": "./lib/cli.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./materialize/agents": "./lib/materialize/agents.js",
    "./materialize/hook": "./lib/materialize/hook.js",
    "./materialize/mcp": "./lib/materialize/mcp.js",
    "./materialize/skill": "./lib/materialize/skill.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./materialize/output-style": "./lib/materialize/output-style.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "README_cn.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "spike:s1": "node spikes/s1-loader/run.mjs",
    "rig": "node packages/dsh-anyplugin-conformance/src/rig.ts",
    "capture:fixtures": "node scripts/capture-fixtures.mjs",
    "fetch:harness": "node scripts/fetch-harness.mjs",
    "fetch:claude": "node scripts/fetch-claude.mjs",
    "fetch:mod": "node scripts/fetch-mod.mjs",
    "gen:types": "node scripts/gen-mod-types.mjs",
    "test": "node --experimental-vm-modules --test \"packages/**/*.test.mjs\" \"scripts/**/*.test.mjs\"",
    "pretest": "npm run build",
    "extract:hooks": "node scripts/extract-hook-payloads.mjs",
    "check:arch": "node scripts/check-architecture.mjs",
    "gh-bot": "node scripts/gh-bot.mjs",
    "build": "node scripts/build.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepack": "npm run build",
    "verify": "npm run check:arch && npm run check:features && npm run check:decisions && npm run check:pack && npm test",
    "spike:s9": "node spikes/s9-host-events/run.mjs",
    "spike:s10": "node spikes/s10-agents/run.mjs",
    "spike:s11": "node spikes/s11-prompt-scope/run.mjs",
    "spike:s12": "node spikes/s12-hook-fanout/run.mjs",
    "spike:s13": "node --experimental-vm-modules spikes/s13-mod-load/run.mjs",
    "spike:s16": "node spikes/s16-agent-faces/run.mjs",
    "spike:s19": "node spikes/s19-path/run.mjs",
    "spike:s21": "node spikes/s21-client-panel/run.mjs",
    "check:features": "node scripts/check-features.mjs",
    "guard:install": "node scripts/guard-install.mjs",
    "guard:status": "node scripts/guard-status.mjs",
    "triage": "node scripts/triage.mjs",
    "check:decisions": "node scripts/check-decisions.mjs"
  },
  "dependencies": {
    "@babel/core": "7.29.13",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@modelcontextprotocol/client": "2.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-group": "1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "esbuild": "0.28.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
