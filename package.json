{
  "name": "dsh-anyplugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Run Claude Code / Codex plugins inside DeepSeek Harness, at declared 100% fidelity.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spike:s1": "node spikes/s1-loader/run.mjs",
    "rig": "node packages/dsh-anyplugin-conformance/src/rig.ts",
    "capture:fixtures": "node scripts/capture-fixtures.mjs",
    "fetch:harness": "node scripts/fetch-harness.mjs",
    "fetch:claude": "node scripts/fetch-claude.mjs",
    "test": "node --test",
    "extract:hooks": "node scripts/extract-hook-payloads.mjs",
    "check:arch": "node scripts/check-architecture.mjs",
    "verify": "npm run check:arch && npm test",
    "spike:s9": "node spikes/s9-host-events/run.mjs",
    "spike:s10": "node spikes/s10-agents/run.mjs",
    "spike:s12": "node spikes/s12-hook-fanout/run.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-group": "1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
