{
  "name": "dsh-anyplugin-ui",
  "version": "0.3.0",
  "description": "The AnyPlugin panel: what installs.yml declares, and an install-from-a-local-path form.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "dsh-anyplugin": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "dsh-anyplugin": {
      "optional": true
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szchan/dsh-anyplugin.git"
  },
  "engines": {
    "node": ">=22.14"
  }
}
